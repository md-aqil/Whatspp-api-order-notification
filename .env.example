# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=whatsapp_api
DB_USER=root
DB_PASSWORD=

# Or use a connection string
# DATABASE_URL=mysql://user:password@localhost:3306/whatsapp_api

# WordPress Database (optional)
# WP_DB_HOST=localhost
# WP_DB_PORT=3306
# WP_DB_NAME=wordpress
# WP_DB_USER=root
# WP_DB_PASSWORD=

# WhatsApp Configuration
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Security (Enterprise)
ENCRYPTION_KEY=your_secret_32_char_key_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here
REDIS_URL=redis://localhost:6379

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# WhatsApp Webhook Verify Token
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here

# Zoho CRM Configuration
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REDIRECT_URI=http://localhost:3000/api/integrations/zoho/callback
ZOHO_DC=zoho.in

# QR-code "Connect" flow (scan to link Shopify + WhatsApp)
SHOPIFY_CLIENT_ID=your_shopify_app_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_app_client_secret
SHOPIFY_SCOPES=read_products,read_orders,write_orders,read_customers,read_checkouts,read_fulfillments,write_webhooks
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

